# ==============================================================================
# RAG Technical Documentation Assistant - Environment Configuration Template
# Copy this file to .env and configure your parameters.
# ==============================================================================

# LLM Configuration
# Supported providers: "gemini", "openai", "mock" (offline/deterministic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
# Uses lightweight local sentence-transformers model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=fastapi_docs

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
MAX_RETRIES=2

# Security & Ingestion Limits
MAX_FILE_SIZE_MB=5
REQUEST_TIMEOUT_SECONDS=10
ALLOWED_EXTENSIONS=.md,.txt,.html

# SQLite Storage for Feedback
FEEDBACK_DB_PATH=./data/feedback.db

# API Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501
